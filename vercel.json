{
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        },
        {
          "key": "Permissions-Policy",
          "value": "loopback-network=*, local-network=*"
        }
      ]
    }
  ],
  "buildCommand": "node scripts/import-robolink-images.cjs",
  "outputDirectory": "public"
}
